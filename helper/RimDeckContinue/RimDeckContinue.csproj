<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The helper mod behind RimDeck's Continue button. Built for .NET Framework 4.7.2, which every
    RimWorld version from 1.4 on can load. Build with:
      dotnet build helper/RimDeckContinue -c Release -p:GameDir="<RimWorld folder>"
    then copy bin/Release/RimDeckContinue.dll to resources/helper/.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>RimDeckContinue</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\RimWorld</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath Condition="Exists('$(GameDir)\Assembly-CSharp.dll')">$(GameDir)\Assembly-CSharp.dll</HintPath>
      <HintPath Condition="!Exists('$(GameDir)\Assembly-CSharp.dll')">$(GameDir)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
